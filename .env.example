# ---- GitHub ----
# 全リポジトリを置く Organization 名
GITHUB_ORG=AP-Slop
# Org 管理権限を持つトークン (fine-grained PAT: Administration/Contents/Members/Webhooks RW)
GITHUB_ADMIN_TOKEN=
# 利用者ログイン用 OAuth App
GITHUB_CLIENT_ID=Iv1.xxx
GITHUB_CLIENT_SECRET=xxx
# Org webhook の secret
GITHUB_WEBHOOK_SECRET=Attendance123!

# ---- Auth.js ----
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-5

# ---- web ----
DATABASE_URL=file:./data/openap.db
# ブラウザから見える公開 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_URL=http://localhost:8080
# 大学名など表示用
NEXT_PUBLIC_SITE_NAME=OpenAP

# ---- store-server ----
# web から store-server を呼ぶときの内部 URL (compose 内)
STORE_SERVER_URL=http://store-server:8080
# web ↔ store-server 間の共有トークン
STORE_TOKEN=change-me
# ホスト側に公開するポート (8080 が他プロセスで使用中なら変更し、下の 2 つの URL も合わせる)
STORE_PORT=8080
# 公開 URL (index に埋め込まれる)
STORE_PUBLIC_URL=http://localhost:8080
STORE_REPO_NAME=OpenAP University Apps
STORE_REPO_DESCRIPTION=大学コミュニティで作られたアプリの F-Droid 互換リポジトリ
# APK 署名鍵 / リポジトリ鍵のパスワード
STORE_KEY_PASSWORD=change-me

# ---- 本番 (docker-compose.prod.yml / Caddy) ----
# 公開ホスト名。Caddy がこの名前で Let's Encrypt 証明書を取得する
# 本番では次も合わせて変更する:
#   AUTH_URL / NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_STORE_URL / STORE_PUBLIC_URL = https://<OPENAP_DOMAIN>
OPENAP_DOMAIN=openap.example.com
# リバースプロキシ配下では必須 (Auth.js が X-Forwarded-* を信頼する)
AUTH_TRUST_HOST=true
