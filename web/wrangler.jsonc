// Cloudflare Workers deployment of the web app (OpenNext). See docs/DEPLOY_CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apslop-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "apslop-web" }],
  // AI generation waits minutes on the model; waiting is not CPU time, but parsing/committing can be.
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apslop",
      "database_id": "84314678-fca8-4d3d-8501-ffe6b03d705f",
      "migrations_dir": "prisma/d1-migrations"
    }
  ],
  // Background jobs (AI proposals) that must outlive the request; consumed in cloudflare/worker.ts.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "apslop-jobs" }],
    "consumers": [{ "queue": "apslop-jobs", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }]
  },
  // The store: store-server/ in a container (one instance, "store"), its files in R2 (served by cloudflare/worker.ts).
  "containers": [
    { "class_name": "StoreContainer", "image": "../store-server/Dockerfile", "instance_type": "standard-1", "max_instances": 1 }
  ],
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "StoreContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreContainer"] }],
  "r2_buckets": [{ "binding": "STORE_FILES", "bucket_name": "apslop-store" }],
  "observability": { "enabled": true },
  // Non-secret settings (see docs/ARCHITECTURE.md). Secrets are set with `wrangler secret`.
  "vars": {
    "GITHUB_ORG": "AP-Slop",
    "AUTH_URL": "https://apslop-web.taku1029-dev.workers.dev",
    "AUTH_TRUST_HOST": "true",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "NEXT_PUBLIC_APP_URL": "https://apslop-web.taku1029-dev.workers.dev",
    "NEXT_PUBLIC_STORE_URL": "https://apslop-web.taku1029-dev.workers.dev",
    "NEXT_PUBLIC_SITE_NAME": "APSlop"
  }
}
